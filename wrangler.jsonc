// Configuração do Worker (frontend + API no mesmo deploy).
// O ambiente é escolhido no BUILD: CLOUDFLARE_ENV=staging npm run build
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teamup",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "not_found_handling": "single-page-application",
    // Rotas /api/* sempre passam pelo Worker antes dos arquivos estáticos
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },

  // Top-level = desenvolvimento local e o container de testes (DAST)
  "vars": { "APP_ENV": "local" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teamup-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "env": {
    "staging": {
      "name": "teamup-staging",
      "vars": { "APP_ENV": "staging" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "teamup-staging",
          "database_id": "0ccb1d14-0835-4b04-baa0-7448ea7c1362",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "teamup",
      // Sem domínio próprio: publica em teamup.<subdominio>.workers.dev.
      // Quando tiverem domínio (e WAF), troque workers_dev para false e adicione:
      //   "routes": [{ "pattern": "teamup.seudominio.com.br", "custom_domain": true }],
      // Assim o tráfego só entra pelo domínio, onde o WAF fica na frente do Worker.
      "workers_dev": true,
      "preview_urls": false,
      "vars": { "APP_ENV": "production" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "teamup-production",
          "database_id": "efb1c3e6-bf0c-4fef-8a3f-ab084783c295",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
